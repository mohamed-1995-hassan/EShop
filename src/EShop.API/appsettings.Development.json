{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "EShop": "Debug"
    }
  },
  
  "ConnectionStrings": {
    "Database": "Host=localhost;Database=eshop_dev;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },

  "Jwt": {
    "Secret": "DevelopmentSecretKeyForLocalTestingOnly12345678901234567890",
    "Issuer": "EShop.API.Dev",
    "Audience": "EShop.Client.Dev",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30,
    "RotateRefreshTokens": true,
    "ClockSkewSeconds": 30
  },

  "Password": {
    "MinimumLength": 6,
    "RequireUppercase": false,
    "RequireLowercase": false,
    "RequireDigit": false,
    "RequireSpecialCharacter": false,
    "MaxFailedAttempts": 10,
    "LockoutMinutes": 5
  }
}
