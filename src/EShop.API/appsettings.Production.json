{
  "$schema": "https://json.schemastore.org/appsettings.json",
  
  "// IMPORTANT": "All secrets should come from environment variables or secret stores",
  "// DO NOT": "Store real credentials in this file - use environment variables or secret management",

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "EShop": "Information"
    }
  },

  "AllowedHosts": "*",

  "// Secrets Configuration": "Set Secrets__Provider env var to: azurekeyvault, awssecretsmanager, or environment",
  "Secrets": {
    "Provider": "environment",
    "AzureKeyVault": {
      "VaultUri": ""
    },
    "AwsSecretsManager": {
      "SecretName": "",
      "Region": "us-east-1"
    }
  },

  "// Connection Strings": "Override via environment: ConnectionStrings__Database, ConnectionStrings__Redis",
  "ConnectionStrings": {
    "Database": "",
    "Redis": "",
    "EventStore": ""
  },

  "// JWT Configuration": "Override via environment: Jwt__Secret",
  "Jwt": {
    "Secret": "",
    "Issuer": "EShop.API",
    "Audience": "EShop.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "RotateRefreshTokens": true,
    "ClockSkewSeconds": 0
  },

  "Password": {
    "MinimumLength": 12,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 30
  },

  "// Email Configuration": "Override via environment: Email__SendGrid__ApiKey, etc.",
  "Email": {
    "Provider": "SendGrid",
    "DefaultFromEmail": "",
    "DefaultFromName": "EShop",
    "EnableTracking": true,
    "SendGrid": {
      "ApiKey": "",
      "SandboxMode": false
    },
    "AmazonSes": {
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Region": "us-east-1",
      "ConfigurationSetName": ""
    }
  },

  "// Stripe Configuration": "Override via environment: Stripe__SecretKey, Stripe__WebhookSecret",
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "DefaultCurrency": "usd",
    "SuccessUrl": "",
    "CancelUrl": "",
    "AutomaticTax": false,
    "CaptureMethod": "automatic",
    "PaymentMethodTypes": ["card"],
    "StatementDescriptor": "ESHOP",
    "Enable3DSecure": true
  },

  "// OAuth Configuration": "Override via environment: OAuth__Google__ClientId, etc.",
  "OAuth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": ""
    },
    "Apple": {
      "ClientId": "",
      "TeamId": "",
      "KeyId": "",
      "PrivateKey": ""
    },
    "Microsoft": {
      "ClientId": "",
      "ClientSecret": "",
      "TenantId": ""
    }
  },

  "// RabbitMQ Configuration": "Override via environment: RabbitMQ__Host, etc.",
  "RabbitMQ": {
    "Host": "",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": ""
  },

  "// Observability": "Override via environment: Observability__OtlpEndpoint",
  "Observability": {
    "OtlpEndpoint": "",
    "ServiceName": "eshop-api",
    "ServiceVersion": "1.0.0"
  },

  "// Security": "Override via environment: Encryption__MasterKey",
  "Encryption": {
    "MasterKey": "",
    "Salt": ""
  },

  "// Feature Flags": "Enable/disable optional features",
  "EventSourcing": {
    "Enabled": false
  },
  "CQRS": {
    "Enabled": false
  }
}
