{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "ConnectionStrings": {
    "Database": "Host=localhost;Database=eshop;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },

  "Jwt": {
    "Secret": "YourSuperSecretKeyHereMustBeAtLeast32CharactersLong!",
    "Issuer": "EShop.API",
    "Audience": "EShop.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "RotateRefreshTokens": true,
    "ClockSkewSeconds": 0
  },

  "Password": {
    "MinimumLength": 8,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },

  "Email": {
    "// Provider Options": "Fake (default/dev), SendGrid, AmazonSes, Smtp",
    "Provider": "Fake",
    "DefaultFromEmail": "noreply@eshop.com",
    "DefaultFromName": "EShop",
    "EnableTracking": true,
    
    "SendGrid": {
      "ApiKey": "SG.your-sendgrid-api-key",
      "SandboxMode": false
    },
    
    "AmazonSes": {
      "AccessKeyId": "your-aws-access-key",
      "SecretAccessKey": "your-aws-secret-key",
      "Region": "us-east-1",
      "ConfigurationSetName": ""
    },
    
    "Smtp": {
      "Host": "smtp.example.com",
      "Port": 587,
      "Username": "your-smtp-username",
      "Password": "your-smtp-password",
      "EnableSsl": true
    },
    
    "Templates": {
      "TemplateDirectory": "EmailTemplates",
      "DefaultTemplateName": "default"
    }
  },

  "Stripe": {
    "SecretKey": "sk_test_YOUR_SECRET_KEY",
    "PublishableKey": "pk_test_YOUR_PUBLISHABLE_KEY",
    "WebhookSecret": "whsec_YOUR_WEBHOOK_SECRET",
    "DefaultCurrency": "usd",
    "SuccessUrl": "https://yourdomain.com/payment/success?session_id={CHECKOUT_SESSION_ID}",
    "CancelUrl": "https://yourdomain.com/payment/cancel",
    "AutomaticTax": false,
    "CaptureMethod": "automatic",
    "PaymentMethodTypes": ["card"],
    "StatementDescriptor": "ESHOP",
    "Enable3DSecure": true
  },

  "OAuth": {
    "Google": {
      "ClientId": "your-google-client-id",
      "ClientSecret": "your-google-client-secret"
    },
    "Facebook": {
      "AppId": "your-facebook-app-id",
      "AppSecret": "your-facebook-app-secret"
    },
    "Apple": {
      "ClientId": "your-apple-client-id",
      "TeamId": "your-apple-team-id",
      "KeyId": "your-apple-key-id",
      "PrivateKey": "your-apple-private-key"
    },
    "Microsoft": {
      "ClientId": "your-microsoft-client-id",
      "ClientSecret": "your-microsoft-client-secret",
      "TenantId": "common"
    }
  }
}
