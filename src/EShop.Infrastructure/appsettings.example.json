{
  "ConnectionStrings": {
    "Database": "Host=localhost;Database=eshop;Username=postgres;Password=postgres",
    "Redis": "localhost:6379",
    "EventStore": "Host=localhost;Database=eshop_events;Username=postgres;Password=postgres"
  },
  
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "PrefetchCount": 16,
    "ConnectionTimeoutSeconds": 30,
    "UseSsl": false
  },
  
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "eshop:",
    "DefaultDatabase": 0,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "AbortOnConnectFail": false
  },
  
  "Encryption": {
    "MasterKey": "YOUR-MASTER-KEY-FROM-KEY-VAULT-32-CHARS",
    "Salt": "YOUR-UNIQUE-SALT-VALUE-HERE",
    "CurrentKeyVersion": 1
  },
  
  "Observability": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "EShop.API",
    "ServiceVersion": "1.0.0",
    "EnableTracing": true,
    "EnableMetrics": true,
    "SamplingRatio": 1.0
  },
  
  "DeadLetterQueue": {
    "MaxRetryAttempts": 5,
    "InitialRetryDelayMs": 1000,
    "MaxRetryDelayMs": 60000,
    "RetryDelayMultiplier": 2.0,
    "MessageTtlHours": 168
  },
  
  "Resilience": {
    "Database": {
      "MaxRetries": 3,
      "TimeoutSeconds": 30
    },
    "HttpClient": {
      "MaxRetries": 3,
      "TimeoutSeconds": 10,
      "CircuitBreakerFailureThreshold": 0.5,
      "CircuitBreakerDuration": 30
    },
    "PaymentGateway": {
      "MaxRetries": 5,
      "TimeoutSeconds": 60
    }
  },
  
  "OutboxProcessor": {
    "PollingIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxRetries": 5
  },
  
  "RetryScheduler": {
    "PollingIntervalSeconds": 10,
    "MaxConcurrentRetries": 10,
    "DefaultMaxAttempts": 5
  },
  
  "RateLimiting": {
    "Default": {
      "Limit": 100,
      "WindowSeconds": 60
    },
    "Api": {
      "Limit": 1000,
      "WindowSeconds": 3600
    },
    "Payment": {
      "Limit": 5,
      "WindowSeconds": 60
    }
  },
  
  "Caching": {
    "DefaultExpirationMinutes": 5,
    "ProductCacheMinutes": 30,
    "CustomerCacheMinutes": 15
  },
  
  "HealthChecks": {
    "Outbox": {
      "MaxAgeMinutes": 10,
      "MaxPendingMessages": 100
    },
    "DeadLetter": {
      "WarningThreshold": 10,
      "CriticalThreshold": 50
    }
  },
  
  "EventSourcing": {
    "Enabled": false,
    "SnapshotInterval": 100
  },
  
  "CQRS": {
    "Enabled": false,
    "ProjectionBatchSize": 100,
    "ProjectionPollIntervalMs": 100
  },
  
  "Development": {
    "EnableSensitiveDataLogging": false
  }
}
